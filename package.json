{
  "name": "wichtelo",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "next dev --turbopack --experimental-https",
    "build": "next build  --turbopack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:pr": "node scripts/e2e-pr.mjs",
    "verify": "node scripts/verify.mts",
    "check:pii": "node scripts/check-no-pii.mts",
    "e2e:dev": "PLAYWRIGHT_BASE_URL=https://localhost:3000 playwright test",
    "e2e:preview": "playwright test",
    "e2e:live": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:push": "supabase db push",
    "db:push:staging": "node --env-file-if-exists=supabase/.env.local scripts/supabase-remote.mjs staging db push",
    "db:push:live": "node --env-file-if-exists=supabase/.env.local scripts/supabase-remote.mjs live db push",
    "db:migration": "supabase migration new",
    "db:config:push:staging": "node --env-file-if-exists=supabase/.env.local scripts/supabase-remote.mjs staging config push",
    "db:config:push:live": "node --env-file-if-exists=supabase/.env.local scripts/supabase-remote.mjs live config push"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@loglayer/transport-pino": "^3.0.2",
    "@loglayer/transport-simple-pretty-terminal": "^3.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "loglayer": "^9.1.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.32.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^30.1.2",
    "knip": "^6.13.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-email": "^6.1.1",
    "shadcn": "^4.7.0",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
