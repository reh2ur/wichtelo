{
  "name": "wichtelo",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack --experimental-https",
    "build": "next build  --turbopack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:pr": "node scripts/e2e-pr.mjs",
    "verify": "node scripts/verify.mts",
    "check:pii": "node scripts/check-no-pii.mts",
    "e2e:dev": "PLAYWRIGHT_BASE_URL=https://localhost:3000 playwright test",
    "e2e:preview": "playwright test",
    "e2e:live": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:push": "supabase db push",
    "db:push:staging": "node --env-file-if-exists=supabase/.env.local scripts/supabase-remote.mjs staging db push",
    "db:push:live": "node --env-file-if-exists=supabase/.env.local scripts/supabase-remote.mjs live db push",
    "db:migration": "supabase migration new",
    "db:config:push:staging": "node --env-file-if-exists=supabase/.env.local scripts/supabase-remote.mjs staging config push",
    "seed:demo": "node --env-file-if-exists=.env.local --env-file-if-exists=supabase/.env.local scripts/seed-demo.mts seed",
    "seed:login": "node --env-file-if-exists=.env.local --env-file-if-exists=supabase/.env.local scripts/seed-demo.mts login",
    "db:config:push:live": "node --env-file-if-exists=supabase/.env.local scripts/supabase-remote.mjs live config push"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@loglayer/transport-pino": "^3.3.0",
    "@loglayer/transport-simple-pretty-terminal": "^3.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^11.12.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-table": "^9.3.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "loglayer": "^9.4.0",
    "next": "16.4.6",
    "next-intl": "^4.14.10",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.38.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^18.0.10",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jsdom": "^31.0.0",
    "knip": "^6.45.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-email": "^6.11.11",
    "shadcn": "^4.23.0",
    "supabase": "^3.1.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
