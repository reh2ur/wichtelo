# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── Account deletion ────────────────────────────────────────────────────────
# HMAC secret for emailed account-deletion links. Required in production
# (>= 32 chars, e.g. `openssl rand -base64 48`); never reuse the service-role key.
# Dev/preview fall back to a built-in constant.
ACCOUNT_DELETION_SECRET=<random-32+-char-secret>

# ─── Site origin ─────────────────────────────────────────────────────────────
# Canonical public origin used for links in emails. Required in production.
NEXT_PUBLIC_SITE_URL=https://<your-production-domain>

# ─── Admin back-office ──────────────────────────────────────────────────────
# Email of the single super-admin. Grants access to /admin/** (proxy.ts guard)
# and lets that email create its account on a fresh deployment (see app/anmelden/actions.ts).
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# ─── Impressum (§ 5 DDG) ──────────────────────────────────────────────────────
# Operator identity shown on /impressum. Required in production (legal duty on
# the live site); dev/preview render placeholders when unset.
OPERATOR_NAME=<full name>
OPERATOR_ADDRESS_LINE1=<street and number>
OPERATOR_ADDRESS_LINE2=<postcode and city>
OPERATOR_CONTACT_EMAIL=<contact email>

# ─── Supabase config push (CLI only, not read by the app) ─────────────────────
# supabase/config.toml [remotes.*] reads these via env(...) on `supabase config push`.
# LIVE_SITE_URL=https://<your-production-domain>
# LIVE_REDIRECT_URL=https://<your-production-domain>/**
# STAGING_PREVIEW_REDIRECT_URL=https://<project>-*-<vercel-team>-projects.vercel.app/**
# AUTH_SMTP_ADMIN_EMAIL=<sender address, e.g. wichtelo@yourdomain.com>
# SUPABASE_PROJECT_REF_LIVE=<live project ref>
# SUPABASE_PROJECT_REF_STAGING=<staging project ref>
# Put these in supabase/.env.local (gitignored). `pnpm db:push:*` and
# `pnpm db:config:push:*` load them via scripts/supabase-remote.mjs.
# Refs must also match `project_id` in supabase/config.toml [remotes.*] (literal).
# Also set SUPABASE_PROJECT_REF_LIVE in the app env: E2E backdoors refuse to
# run against that project (lib/test-backdoor.ts).

# ─── Resend ───────────────────────────────────────────────────────────────────
# Found in: resend.com → API Keys
RESEND_API_KEY=re_<key>
RESEND_FROM_EMAIL=wichtelo@yourdomain.com

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Found in: Sentry dashboard → Settings → Projects → <project> → Client Keys (DSN)
# DSN isn't secret (ships in client bundle); ORG/PROJECT only needed at build time
# for source map upload (sentry.config in next.config.ts). Unset = Sentry disabled.
# Use an EU-region Sentry org (ingest.de.sentry.io) — Datenschutz states EU data region.
# SENTRY_AUTH_TOKEN (build-time, secret, source map upload) goes in Vercel env only.
NEXT_PUBLIC_SENTRY_DSN=https://<public-key>@o<org-id>.ingest.de.sentry.io/<project-id>
SENTRY_ORG=<org-slug>
SENTRY_PROJECT=<project-slug>

# ─── Rate limiting (Upstash Redis) ─────────────────────────────────────────────
# Found in: Upstash dashboard → Redis database → REST API
# Optional locally — lib/rate-limit.ts allows all requests when unset (dev/tests).
UPSTASH_REDIS_REST_URL=https://<db-name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<rest-token>

# ─── Supabase Auth config (managed in repo, not dashboard) ────────────────────
# Auth settings, mail templates (supabase/templates/*.html incl. 6-digit OTP),
# redirect allow-list and SMTP live in supabase/config.toml. Local stack reads it
# directly; hosted projects get it via `pnpm db:config:push:{staging,live}` (reads
# the CLI-only vars above). Editing config.toml alone does NOT change hosted projects.
# Do not edit templates or URL config in the dashboard (next push overwrites it).
# Redirect allow-list: live = LIVE_REDIRECT_URL, staging = localhost +
# STAGING_PREVIEW_REDIRECT_URL (preview wildcard).
#
# ─── Staging Supabase project (used by Vercel preview deployments) ────────────
# Staging uses real Resend SMTP too ([remotes.staging.auth.email.smtp], email_sent
# = 100/h). E2E tests bypass email delivery via the admin API; the OTP is still
# written to the DB. No "null SMTP" hack — do not point staging SMTP at an
# unreachable host. Never use real user emails on staging.
#
# ─── E2E / Playwright ────────────────────────────────────────────────────────
# Tests load .env.e2e (committed defaults) then .env.e2e.local (gitignored secrets).
#
# VERCEL_AUTOMATION_BYPASS_SECRET=<secret>
#   Required to reach /api/test/* on password-protected Vercel deployments.
#   Found in: Vercel dashboard → Project → Settings → Deployment Protection →
#             "Protection Bypass for Automation" → generate secret.
#   Add as a GitHub Actions secret named VERCEL_AUTOMATION_BYPASS_SECRET for CI.
#
# Auth tests (/api/test/otp, /api/test/session) are automatically enabled on
# local (NODE_ENV=development) and Vercel preview (VERCEL_ENV=preview) — no
# extra env var required to activate them.
