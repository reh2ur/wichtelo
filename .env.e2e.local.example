# E2E test overrides — copy to .env.e2e.local and fill in values.
# This file is committed; .env.e2e.local is gitignored.

# Required for tests targeting a Vercel preview deployment with protection enabled.
# Find it in Vercel Dashboard → Project → Settings → Deployment Protection.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Unlocks /api/test/* + devOtp backdoors. Local: set both here (Playwright
# passes env to the dev server it starts). Preview: E2E_TEST_MODE=1 +
# E2E_TEST_SECRET in Vercel Preview env, same secret in GitHub secret
# E2E_TEST_SECRET. NEVER set in Production. Generate: openssl rand -hex 32
E2E_TEST_MODE=1
E2E_TEST_SECRET=
